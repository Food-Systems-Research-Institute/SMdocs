@article{berkesREDISCOVERYTRADITIONALECOLOGICAL2000,
  title = {{{REDISCOVERY OF TRADITIONAL ECOLOGICAL KNOWLEDGE AS ADAPTIVE MANAGEMENT}}},
  author = {Berkes, Fikret and Colding, Johan and Folke, Carl},
  year = 2000,
