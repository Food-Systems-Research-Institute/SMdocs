@article{monus2021EnvironmentalPerceptionsProenvironmental,
  title = {Environmental Perceptions and Pro-Environmental Behavior -- Comparing Different Measuring Approaches},
  author = {M{\'o}nus, Ferenc},
  year = 2021,
