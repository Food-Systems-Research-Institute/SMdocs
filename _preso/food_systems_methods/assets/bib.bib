@article{liem2025FutureOnlineWebbased,
  title = {The Future of Online or Web-Based Research. {{Have}} You Been {{BOTTED}}?},
  author = {Liem, Djin Gie},
  year = 2025,
  month = sep,
  journal = {Appetite},
  volume = {213},
  pages = {108058},
  issn = {0195-6663},
  doi = {10.1016/j.appet.2025.108058},
  urldate = {2025-08-18},
  abstract = {In the early 2000s few manuscripts based on web or online surveys were published by social science and psychology journals. Since the COVID-19 pandemic this number has increased exponentially to more than 10,000 papers in 2023. Online surveys are often widely advertised through publicly accessible platforms, which generate data but increase the risks of fraudulent internet robots (BOT) responses. It has been estimated that survey responses can consist of more than 90~\% BOT responses. BOT responses can impact the integrity of online research, thus degrading science, trust in science, and social discourse. To minimise BOT responses a collective awareness, transparency and control from researchers, reviewers and editors is needed. This commentary discusses this issue and aims to raise awareness of the risk BOTS pose in the scientific community in general, and for appetite research specifically.},
  file = {C\:\\Users\\cdonov12\\Zotero\\storage\\28VQHIV2\\Liem - 2025 - The future of online or web-based research. Have you been BOTTED.pdf;C\:\\Users\\cdonov12\\Zotero\\storage\\KFUVRQGR\\S0195666325002119.html}
}

@article{liess2022HighResolutionClimateProjections,
  title = {High-{{Resolution Climate Projections Over Minnesota}} for the 21st {{Century}}},
  author = {Liess, Stefan and Twine, Tracy E. and Snyder, Peter K. and Hutchison, William D. and {Konar-Steenberg}, Gabriel and Keeler, Bonnie L. and Brauman, Kate A.},
  year = 2022,
  journal = {Earth and Space Science},
  volume = {9},
  number = {3},
  pages = {e2021EA001893},
  issn = {2333-5084},
  doi = {10.1029/2021EA001893},
  urldate = {2025-02-10},
  abstract = {Minnesota is the state with the strongest winter warming in the contiguous United States. We performed regional climate projections at 10 km horizontal resolution using the Weather Research Forecasting model forced with eight CMIP5 GCMs. The selected GCMs have previously been found to be in relatively good agreement with observations over Minnesota compared to other members of the CMIP5 model ensemble. Our projections suggest ongoing warming in all seasons, especially in winter, as well as shallower snow depth and fewer days with snow cover. We expect significant increases in spring and early summer heavy precipitation events. Our comparisons between different time slices and two different emission scenarios indicate a climate for the state of Minnesota near the end of the 21st century that is significantly different from what has been observed by the end of the 20th century. Winters and summers are expected to be up to 6 and 4{$^\circ$}C warmer, respectively, over northern and central Minnesota, and spring precipitation may increase by more than 1 mm d-1 over northern Minnesota. Especially over the central part of the state, winter snow depth is projected to decrease by more than 12 cm, and the number of days per year with snow depth of more than 2.54 cm (one inch) is expected to decrease by up to 55.},
  copyright = {{\copyright} 2022 The Authors. Earth and Space Science published by Wiley Periodicals LLC on behalf of American Geophysical Union.},
  langid = {english},
  keywords = {cropland simulations,dynamical downscaling,regional climate change over Midwestern USA,Weather Research and Forecasting (WRF) model},
  file = {C\:\\Users\\cdonov12\\Zotero\\storage\\47CVSVT2\\Liess et al. - 2022 - High-Resolution Climate Projections Over Minnesota.pdf;C\:\\Users\\cdonov12\\Zotero\\storage\\XRTH37NE\\2021EA001893.html}
}

@article{lin2007AgroforestryManagementAdaptive,
  title = {Agroforestry Management as an Adaptive Strategy against Potential Microclimate Extremes in Coffee Agriculture},
  author = {Lin, Brenda B.},
  year = 2007,
  month = may,
  journal = {Agricultural and Forest Meteorology},
  volume = {144},
  number = {1},
  pages = {85--94},
  issn = {0168-1923},
  doi = {10.1016/j.agrformet.2006.12.009},
  urldate = {2024-07-07},
  abstract = {Current climate change patterns may cause more extreme and variable climates in the future, threatening agricultural productivity in many areas of the world. Because many smallholder, rural farmers depend on subsistence, rainfed agriculture, priorities should be focused on coping mechanisms that protect these farmers from future vulnerabilities. This paper examines one possible adaptive strategy for coffee agriculture. A high (60--80\%), medium (35--65\%), and low (10--30\%) shade coffee site were chosen in the Soconusco region of Chiapas, Mexico. Microclimate and soil moisture data were collected to examine the ability of shade tree cover in an agroforestry system to protect crop plants against extremes in microclimate and soil moisture fluctuation. Site and site by time effects were analyzed using linear mixed models to compare mean differences of microclimate measurements (temperature, relative humidity, and solar radiation) by site as well as by time of the day. Although there were not large differences in seasonal means for these factors, site by time effects show that temperature, humidity, and solar radiation fluctuations increase significantly as shade cover decreases. Soil data showed significantly larger fluctuations in soil moisture gain and loss in the low shade site respective of patterns of precipitation. Overall, the amount of shade cover was directly related to the mitigation of variability in microclimate and soil moisture for the crop of interest. The use of agroforestry systems is an economically feasible way to protect crop plants from extremes in microclimate and soil moisture and should be considered a potential adaptive strategy for farmers in areas that will suffer from extremes in climate.},
  keywords = {Adaptive management,Agroforestry systems,Climate change,Coffee agriculture,Microclimate management,Soil moisture fluctuation},
  file = {C\:\\Users\\cdonov12\\Zotero\\storage\\CHI626BY\\Lin - 2007 - Agroforestry management as an adaptive strategy ag.pdf;C\:\\Users\\cdonov12\\Zotero\\storage\\TQYUD3XY\\S0168192307000548.html}
}

@article{lin2008SynergiesAgriculturalIntensification,
  title = {Synergies between {{Agricultural Intensification}} and {{Climate Change Could Create Surprising Vulnerabilities}} for {{Crops}}},
  author = {Lin, Brenda B. and Perfecto, Ivette and Vandermeer, John},
  year = 2008,
  month = oct,
  journal = {BioScience},
  volume = {58},
  number = {9},
  pages = {847--854},
  issn = {0006-3568},
  doi = {10.1641/B580911},
  urldate = {2024-12-12},
  abstract = {An inevitable consequence of global climate change is that altered patterns of temperature and precipitation threaten agriculture in many tropical regions, requiring strategies of human adaptation. Moreover, the process of management intensification in agriculture has increased and may exacerbate vulnerability to climate extremes. Although many solutions have been presented, the role of simple agroecological and agroforestry management has been largely ignored. Some recent literature has shown how sustainable management may improve agroecological resistance to extreme climate events. We comment specifically on a prevalent form of agriculture throughout Latin America, the coffee agroforestry system. Results from the coffee literature have shown that shade management in coffee systems may mitigate the effects of extreme temperature and precipitation, thereby reducing the ecological and economic vulnerability of many rural farmers. We conclude that more traditional forms of agriculture can offer greater potential for adapting to changing conditions than do current intensive systems.},
