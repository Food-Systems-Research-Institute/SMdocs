@article{markland2007GoldenRuleThat,
  title = {The Golden Rule Is That There Are No Golden Rules: {{A}} Commentary on {{Paul Barrett}}'s Recommendations for Reporting Model Fit in Structural Equation Modelling},
  shorttitle = {The Golden Rule Is That There Are No Golden Rules},
  author = {Markland, David},
  year = 2007,
