@article{rawal2020AspectsDietaryDiversity,
  title = {Aspects of {{Dietary Diversity Changes}} across {{Adulthood}} in {{Racially Diverse Adults}}},
  author = {Rawal, Rita and Kuczmarski, Marie Fanelli and Cotugna, Nancy and Brewer, Benjamin C. and Beydoun, May A. and Hughes, Virginia C. and Zonderman, Alan B. and Evans, Michele K.},
  year = 2020,
  month = aug,
  journal = {Nutrients},
  volume = {12},
  number = {8},
  pages = {2455},
  publisher = {Multidisciplinary Digital Publishing Institute},
  issn = {2072-6643},
  doi = {10.3390/nu12082455},
  urldate = {2025-02-28},
  abstract = {Knowledge of various aspects of dietary diversity (DD)---an essential healthful dietary component---across adulthood is limited. This study examined three DD aspects over time in racially diverse adults. Participants were from the National Institute on Aging, Healthy Aging in Neighborhoods of Diversity across the Life Span study. DD measures were calculated at baseline (N = 2177), and first and second examination follow-ups (N = 2140 and N = 2066, respectively) using two 24-h recalls. The count was based on the consumption of {$\geq$}50\% of an equivalent from 21 food groups. Evenness was derived using the Berry-Index adjusted by the food's health value; dissimilarity, by Mahalanobis Distance. Mixed-effects linear regression models were conducted to test changes in DD across adulthood, adjusting for sex, race, poverty status and education as fixed effects, and adjusting for smoking, age and energy as time-dependent variables. Only dissimilarity showed significant interactions of time {\texttimes} race (p = 0.0005), and time {\texttimes} poverty status (p = 0.0325), indicating a slower rate of increase over time in dissimilarity scores among Whites compared with African--Americans and those with income {$>$}125\% poverty versus {$<$}125\% poverty. A significant interaction between time{\texttimes}energy (p {$<$} 0.0001) was noted for both evenness and dissimilarity scores. To our knowledge, this is the first study to document the differential change in dissimilarity scores by race and income over time.},
  copyright = {http://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  keywords = {adults,African-American,count,dietary diversity,dissimilarity,evenness},
  file = {C:\Users\cdonov12\Zotero\storage\TJ8GUKHA\Rawal et al. - 2020 - Aspects of Dietary Diversity Changes across Adulth.pdf}
}

