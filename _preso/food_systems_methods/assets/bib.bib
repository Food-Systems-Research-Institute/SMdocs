@article{ritzel2020EmpiricalEvidenceFactors,
  title = {Empirical Evidence on Factors Influencing Farmers' Administrative Burden: {{A}} Structural Equation Modeling Approach},
  shorttitle = {Empirical Evidence on Factors Influencing Farmers' Administrative Burden},
  author = {Ritzel, Christian and Mack, Gabriele and Portmann, Marco and Heitk{\"a}mper, Katja and Benni, Nadja El},
  year = 2020,
