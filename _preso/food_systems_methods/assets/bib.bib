@article{dubois2023ExchangingWordsEngaging,
  title = {Exchanging Words: {{Engaging}} the Challenges of Sharing Qualitative Research Data},
  shorttitle = {Exchanging Words},
  author = {DuBois, James M. and Mozersky, Jessica and Parsons, Meredith and Walsh, Heidi A. and Friedrich, Annie and Pienta, Amy},
  year = 2023,
