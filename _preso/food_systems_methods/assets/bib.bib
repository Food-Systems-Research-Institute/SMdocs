  author = {Springmann, Marco and Clark, Michael and {Mason-D'Croz}, Daniel and Wiebe, Keith and Bodirsky, Benjamin Leon and Lassaletta, Luis and {de Vries}, Wim and Vermeulen, Sonja J. and Herrero, Mario and Carlson, Kimberly M. and Jonell, Malin and Troell, Max and DeClerck, Fabrice and Gordon, Line J. and Zurayk, Rami and Scarborough, Peter and Rayner, Mike and Loken, Brent and Fanzo, Jess and Godfray, H. Charles J. and Tilman, David and Rockstr{\"o}m, Johan and Willett, Walter},
