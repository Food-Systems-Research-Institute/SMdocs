  author = {Lowrance, Richard and Altier, Lee S. and Newbold, J. Denis and Schnabel, Ronald R. and Groffman, Peter M. and Denver, Judith M. and Correll, David L. and Gilliam, J. Wendell and Robinson, James L. and Brinsfield, Russell B. and Staver, Kenneth W. and Lucas, William and Todd, Albert H.},
  year = 1997,
