@article{ashmeadFluxSocialAdaptability2023,
  title = {In Flux: {{Social}} Adaptability in Two Former Timber Towns Transitioning to New Economies},
  shorttitle = {In Flux},
  author = {Ashmead, Cherilyn P. and Kelly, Erin Clover},
  year = 2023,
  month = aug,
  journal = {Journal of Rural Studies},
  volume = {102},
  pages = {103076},
  issn = {0743-0167},
  doi = {10.1016/j.jrurstud.2023.103076},
  urldate = {2024-01-27},
  abstract = {Rural towns across the US have undergone economic and social restructuring. We focus on two former timber towns adjacent to public lands that are transitioning to new production economies, wherein the communities develop new economic sectors. One of our cases has developed data centers, and the other prisons. Through in-depth interviews with residents, we explore the shifts toward these new sectors and their impacts on community social adaptability, in particular human and social capital and community identity. In both of the communities, there are well-paying jobs in the new production sectors. However, indicators of social adaptability have diverged greatly. In the data center community, there are higher perceived levels of human and social capital, while the prison community has lower levels. Members of both communities describe their community identity as in flux, and voice apprehension about growth and development of new industries, including the possibility that the communities may be shifting single-industry dependence from one sector (timber) to a new sector. Both communities are rebuilding their relationships to adjacent public lands and view those public lands as opportunities for economic diversification.},
  keywords = {Data centers,Prisons,Public lands,Social adaptability,Socioeconomic transitions},
  file = {C\:\\Users\\cdonov12\\Zotero\\storage\\QXKNCATT\\Ashmead and Kelly - 2023 - In flux Social adaptability in two former timber .pdf;C\:\\Users\\cdonov12\\Zotero\\storage\\MMD44MW8\\S0743016723001420.html}
}

