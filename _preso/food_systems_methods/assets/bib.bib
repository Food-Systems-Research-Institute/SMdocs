  title = {Planting Limitations for Arid, Semiarid, and Salt-Desert Shrublands},
  author = {Jordan, G. L.},
  year = 1983,
  pages = {11--16},
  abstract = {A major limitation in revegetation of semiarid rangelands is the difficulty in identifying temperature and precipitation values which limit successful range seedings. However, empirical values which identify arid zones, or inadequate precipitation for successful seedings, can be obtained through Koppen's classification of dry climates based on annual temperatures and seasonal distribution of rainfall. The use of this classification in developing guides for seeding semiarid zones is illustrated.-from Author}
