  author = {Cable, Jennifer and Heymann, David L. and Uzicanin, Amra and Tomori, Oyewale and Marinissen, Maria Julia and Katz, Rebecca and Kerr, Larry and Lurie, Nicole and Parker, Gerald W. and Madad, Syra and Maldin Morgenthau, Beth and Osterholm, Michael T. and Borio, Luciana},
