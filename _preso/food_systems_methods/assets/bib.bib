@article{marsh2009ExploratoryStructuralEquation,
  title = {Exploratory {{Structural Equation Modeling}}, {{Integrating CFA}} and {{EFA}}: {{Application}} to {{Students}}' {{Evaluations}} of {{University Teaching}}},
  shorttitle = {Exploratory {{Structural Equation Modeling}}, {{Integrating CFA}} and {{EFA}}},
  author = {Marsh, Herbert W. and Muth{\'e}n, Bengt and Asparouhov, Tihomir and L{\"u}dtke, Oliver and Robitzsch, Alexander and Morin, Alexandre J. S. and Trautwein, Ulrich},
  year = 2009,
