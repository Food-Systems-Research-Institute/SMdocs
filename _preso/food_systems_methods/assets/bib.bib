@techreport{rannestadPrecisionRestorationMarket2017,
  title = {Precision Restoration: {{Market}} and Situation Analysis},
  author = {Rannestad, E. and Griffiths, John},
  year = 2017,
  number = {August},
  address = {Portland, OR},
  abstract = {The Nature Conservancy has partnered with state and federal entities to develop a series of native seed treatments to address the degradation of sagebrush steppe in the Great Basin, a notoriously difficult restoration problem caused by invasive annual grasses, wildfires, human-caused land disturbances, and other factors. Because site characteristics require different treatments, the Nature Conservancy uses Geographic Information Systems software to map where each seed coating is most effective. This precise approach to rangeland reseeding is called Precision Restoration. This report compiles analysis on the market for native seed in the Great Basin and examines how Precision Restoration fits within the native seed industry's trends. The primary purpose of this report is to present the trends, market problems, and supply chain of the native seed industry so The Nature Conservancy can accurately determine how to best bring Precision Restoration into landscape scale use throughout the Great Basin. On the supply side, the structural organization and qualities of the native seed industry revealed a niche market, characterized by the procurement patterns of one major seed procurer: The Bureau of Land Management (BLM). In addition, our analysis uncovered several areas of production-side risk attributed to unpredictable weather, seed quality variation, and different production requirements and costs required across native species. On the demand side, there is an increasing preference for native seed among seed users, a more recent preference for source identified seed, and an increase in the diversity of species being used in restoration. These trends are driven by government policy and agency preferences, as well as challenges posed by increasing wildfire incidence and the effects of climate change. The culmination of BLM's size and high production risk cause dramatic demand fluctuations each year which leads to volatile prices and inefficient reseeding strategies throughout the Great Basin. For Precision Restoration to be successfully integrated into widespread use, the technology must demonstrate improvements in seedling viability at a price that is equal to, or less than, the value of current viability improvements. The more seed treatments that meet this criterion, the more likely Precision Restoration will improve its potential. Currently, one seed treatment has shown consistent viability improvement and is ready for rollout. If The Nature Conservancy can further diversify its product offerings, it will more effectively mitigate the risks of the native seed restoration market and integrate itself into reseeding efforts in the Great Basin. The most effective scaling pathway available to The Nature Conservancy is one that minimizes initial costs, and more importantly, minimizes industry risk. This report concludes that an in-house production model is not an efficient scaling pathway for Precision Restoration, and a product transfer or open source method will better minimize cost and risk.}
}

@article{raoInternationalIntranationalEquity2014,
