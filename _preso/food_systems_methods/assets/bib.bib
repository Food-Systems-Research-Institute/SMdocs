@phdthesis{ruttenauer2021ExtremeWeatherEvents,
  title = {Extreme Weather Events Elevate Climate Change Belief but Not Pro-Environmental Behaviour},
  author = {R{\"u}ttenauer, Tobias},
  year = 2021,
  address = {Oxford},
  doi = {10.31235/osf.io/574uf},
  abstract = {Studies have documented higher beliefs in climate change and more pro-environmental behaviour among people exposed to extreme weather events. However, it is unclear if extreme weather events induce attitu-dinal and behaviour changes, or if those exposed to the events generally differ from people in unaffected regions. This study links individual-level panel data of 88,983 observations from 35,678 individuals to floods across England and heatwaves across the UK, and applies within-person esti-mators to account for non-random spatial patterns of extreme weather events. Results reveal that individuals are more likely to believe in climate change after being affected by a geographically proximate flood or a temporally proximate heatwave. Still, they do not significantly change their behaviour like energy saving or sustainable shopping. By trend, only individuals with initially high levels of trust in others show slight positive behavioural changes after experiencing an extreme weather event.},
  school = {University of Oxford},
  keywords = {Climate Change,Climate Change Belief,Extreme Weather Events,Floods,Heatwaves,Individual Panel Data,Pro-Environmental Behaviour,Trust},
  file = {C:\Users\cdonov12\Zotero\storage\69JTBWBX\Ruettenauer_Extreme-weather-events.pdf}
}

