@article{cruz2020EffectExtremeWeather,
  title = {Effect of Extreme Weather Events on Mental Health: {{A}} Narrative Synthesis and Meta-Analysis for the {{UK}}},
  shorttitle = {Effect of Extreme Weather Events on Mental Health},
  author = {Cruz, Joana and White, Piran C. L. and Bell, Andrew and Coventry, Peter A.},
  year = 2020,
