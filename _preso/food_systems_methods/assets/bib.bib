@article{sharma2021MachineLearningApplications,
  title = {Machine {{Learning Applications}} for {{Precision Agriculture}}: {{A Comprehensive Review}}},
  shorttitle = {Machine {{Learning Applications}} for {{Precision Agriculture}}},
  author = {Sharma, Abhinav and Jain, Arpit and Gupta, Prateek and Chowdary, Vinay},
