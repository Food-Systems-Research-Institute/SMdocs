@article{copelandImprovingRestorationSuccess2021,
  title = {Improving Restoration Success through a Precision Restoration Framework},
  author = {Copeland, Stella M and Baughman, Owen W and Boyd, Chad S and Davies, Kirk W and Kerby, Jay and Kildisheva, Olga A and Svejcar, Tony},
  year = 2021,
  journal = {Restoration Ecology},
  volume = {29},
  number = {2},
  pages = {1--8},
  doi = {10.1111/rec.13348},
  abstract = {Dryland ecosystems represent a significant portion of global land area, support billions of people, and suffer high rates of landdegradation. Successfully restoring native vegetation to degraded drylands is a global priority and major challenge---highlight-ing the need for more efficient and successful restoration strategies. We introduce the concept of``precision restoration,''whichtargets critical biotic and abiotic barriers to restoration success and applies specific tools or methods based on barrier distribu-tion in space and time. With an example from the sagebrush steppe biome, a North American cold desert, we present a frame-work for precision restoration in drylands that involves: (1) identifying site-specific critical barriers to restoration success,(2) understanding the spatial and temporal variability of each barrier, and (3) applying the best available restoration strategiesgiven the specific barrier and its variability, described in thefirst two steps. This framework aims to enhance restoration successby focusing restoration practices on ameliorating the influential barriers when and where they occur and away from applyingsingular landscape-wide approaches.},
  keywords = {drylands,implications for practice,restoration barriers,sagebrush steppe,seed enhancement technology}
}

