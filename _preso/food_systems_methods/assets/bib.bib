@article{weigelMakingDataWorkflows2020,
  title = {Making {{Data}} and {{Workflows Findable}} for {{Machines}}},
  author = {Weigel, Tobias and Schwardmann, Ulrich and Klump, Jens and Bendoukha, Sofiane and Quick, Robert},
