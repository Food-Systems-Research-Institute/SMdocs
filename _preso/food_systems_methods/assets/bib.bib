@article{castillo2020PrecipitationTemperatureCosta,
  title = {Precipitation and {{Temperature}} in {{Costa Rica}} at the {{End}} of the {{Century Based}} on {{NEX-GDDP Projected Scenarios}}},
  author = {Castillo, Rodrigo and Amador, Jorge A.},
  year = 2020,
  month = dec,
  journal = {Atmosphere},
  volume = {11},
  number = {12},
  pages = {1323},
