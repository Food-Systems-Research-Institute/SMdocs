  shorttitle = {Explaining Differential Vulnerability to Climate Change},
  author = {Thomas, Kimberley and Hardy, R. Dean and Lazrus, Heather and Mendez, Michael and Orlove, Ben and {Rivera-Collazo}, Isabel and Roberts, J. Timmons and Rockman, Marcy and Warner, Benjamin P. and Winthrop, Robert},
  year = 2019,
  journal = {WIREs Climate Change},
  volume = {10},
