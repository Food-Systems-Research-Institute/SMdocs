  volume = {33},
  number = {1},
  pages = {35--44},
  issn = {1532-2998},
  doi = {10.1002/smi.2671},
  urldate = {2023-04-09},
  abstract = {We conducted an online survey including 306 participants aged 18--64 years to assess the general factor of personality (GFP) and Big Five personality traits in relation to individual stress and coping reactions following a shooting emergency alarm at a Swiss university campus. Although the emergency eventually turned out to be a false alarm, various witnesses showed pronounced distress owing to a vast police operation. The GFP structure was replicated using two alternative modelling approaches. Neuroticism related substantially to acute fear and traumatic distress as well as to more enduring maladaptive coping. Agreeableness was negatively associated with the coping strategy of medication use, whereas both agreeableness and conscientiousness related positively to social activity following the emergency. The GFP related moderately to peri-traumatic distress and showed a substantial negative association with medication use and a strong positive association with social activity. In conclusion, both the GFP and Big Five traits significantly moderate stress responses following a stressful life event. The GFP predominantly relates to socially adaptive coping, whereas in particular neuroticism accounts for acute stress reactions such as fear and traumatic distress. These findings support the notion that personality influences how persons react in the face of adversity. Copyright {\copyright} 2016 John Wiley \& Sons, Ltd.},
  langid = {english},
  keywords = {Big Five personality traits,coping,general factor of personality,life event,psychopathology,public mental health,stress reaction},
  file = {C\:\\Users\\cdonov12\\Zotero\\storage\\3B7AL7PH\\Hengartner et al. - 2017 - Big Five Personality Traits and the General Factor.pdf;C\:\\Users\\cdonov12\\Zotero\\storage\\CC456GVZ\\smi.html}
