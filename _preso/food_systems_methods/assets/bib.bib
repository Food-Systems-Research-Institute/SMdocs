@article{voss2008InterpretingAmbiguousStimuli,
  title = {Interpreting Ambiguous Stimuli: {{Separating}} Perceptual and Judgmental Biases},
  shorttitle = {Interpreting Ambiguous Stimuli},
  author = {Voss, Andreas and Rothermund, Klaus and Brandtst{\"a}dter, Jochen},
