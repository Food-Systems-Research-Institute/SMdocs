@article{gennuso2015ReliabilityValidity2,
  title = {Reliability and {{Validity}} of 2 {{Self-Report Measures}} to {{Assess Sedentary Behavior}} in {{Older Adults}}},
  author = {Gennuso, Keith P. and Matthews, Charles E. and Colbert, Lisa H.},
  year = 2015,
