@article{ghazali2019ProEnvironmentalBehavioursValueBeliefNorm,
  title = {Pro-{{Environmental Behaviours}} and {{Value-Belief-Norm Theory}}: {{Assessing Unobserved Heterogeneity}} of {{Two Ethnic Groups}}},
