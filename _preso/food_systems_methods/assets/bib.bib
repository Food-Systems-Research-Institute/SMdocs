  langid = {english},
  keywords = {interactions,latent variable,moderation,structural equation modeling},
  file = {C:\Users\cdonov12\Zotero\storage\4D2BSHKV\Schoemann and Jorgensen - 2021 - Testing and Interpreting Latent Variable Interacti.pdf}
