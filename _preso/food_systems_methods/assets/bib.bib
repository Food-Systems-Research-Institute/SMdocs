@article{hernandez-blancoCommonAssetTrusts2024,
  title = {Common {{Asset Trusts}} for Blue Commons Stewardship},
  author = {{Hern{\'a}ndez-Blanco}, Marcello and Costanza, Robert and Agardy, Tundi and Farley, Joshua and Fulton, Elizabeth and Kubiszewski, Ida and Rasheed, Rifaee},
  year = 2024,
