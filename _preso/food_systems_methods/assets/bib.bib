@article{bockstaelEcologicalEconomicModeling1995,
  title = {Ecological Economic Modeling and Valuation of Ecosystems},
  author = {Bockstael, N. and Costanza, R. and Strand, I. and Boynton, W. and Bell, K. and Wainger, L.},
