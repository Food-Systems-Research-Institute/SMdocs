  author = {Kinzig, Ann P. and Ehrlich, Paul R. and Alston, Lee J. and Arrow, Kenneth and Barrett, Scott and Buchman, Timothy G. and Daily, Gretchen C. and Levin, Bruce and Levin, Simon and Oppenheimer, Michael and Ostrom, Elinor and Saari, Donald},
