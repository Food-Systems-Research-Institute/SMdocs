  title = {Warming and {{Earlier Spring Increase Western U}}.{{S}}. {{Forest Wildfire Activity}}},
  author = {{A.L. Westerling} and {H.G. Hidalgo} and {D.R. Cayan} and {T.W. Swetnam}},
