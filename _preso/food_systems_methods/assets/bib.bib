@article{beckage2018LinkingModelsHuman,
  title = {Linking Models of Human Behaviour and Climate Alters Projected Climate Change},
  author = {Beckage, Brian and Gross, Louis J. and Lacasse, Katherine and Carr, Eric and Metcalf, Sara S. and Winter, Jonathan M. and Howe, Peter D. and Fefferman, Nina and Franck, Travis and Zia, Asim and Kinzig, Ann and Hoffman, Forrest M.},
  year = 2018,
  month = jan,
  journal = {Nature Climate Change},
  volume = {8},
  number = {1},
  pages = {79--84},
  publisher = {Nature Publishing Group},
  issn = {1758-6798},
  doi = {10.1038/s41558-017-0031-7},
  urldate = {2023-11-30},
  abstract = {Although not considered in climate models, perceived risk stemming from extreme climate events may induce behavioural changes that alter greenhouse gas emissions. Here, we link the C-ROADS climate model to a social model of behavioural change to examine how interactions between perceived risk and emissions behaviour influence projected climate change. Our coupled climate and social model resulted in a global temperature change ranging from 3.4--6.2\,{$^\circ$}C by 2100 compared with 4.9\,{$^\circ$}C for the C-ROADS model alone, and led to behavioural uncertainty that was of a similar magnitude to physical uncertainty (2.8\,{$^\circ$}C versus 3.5\,{$^\circ$}C). Model components with the largest influence on temperature were the functional form of response to extreme events, interaction of perceived behavioural control with perceived social norms, and behaviours leading to sustained emissions reductions. Our results suggest that policies emphasizing the appropriate attribution of extreme events to climate change and infrastructural mitigation may reduce climate change the most.},
  copyright = {2017 The Author(s)},
  langid = {english},
  keywords = {Climate and Earth system modelling,Climate change},
  file = {C:\Users\cdonov12\Zotero\storage\YF7LTN9B\Beckage et al. - 2018 - Linking models of human behaviour and climate alte.pdf}
}

@article{beckage2020EarthHasHumansa,
  title = {The {{Earth}} Has Humans, so Why Don't Our Climate Models?},
  author = {Beckage, Brian and Lacasse, Katherine and Winter, Jonathan M. and Gross, Louis J. and Fefferman, Nina and Hoffman, Forrest M. and Metcalf, Sara S. and Franck, Travis and Carr, Eric and Zia, Asim and Kinzig, Ann},
  year = 2020,
  month = nov,
  journal = {Climatic Change},
  volume = {163},
  number = {1},
  pages = {181--188},
  issn = {1573-1480},
  doi = {10.1007/s10584-020-02897-x},
  urldate = {2024-06-26},
  abstract = {While climate models have rapidly advanced in sophistication over recent decades, they lack dynamic representation of human behavior and social systems despite strong feedbacks between social processes and climate. The impacts of climate change alter perceptions of risk and emissions behavior that, in turn, influence the rate and magnitude of climate change. Addressing this deficiency in climate models requires a substantial interdisciplinary effort to couple models of climate and human behavior. We suggest a multi-model approach that considers a range of theories and implementations of human behavior and social systems, similar to the multi-model approach that has been used to explore the physical climate system. We describe the importance of linking social factors with climate processes and identify four priorities essential to advancing the development of coupled social-climate models.},
