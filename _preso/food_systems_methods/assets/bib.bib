@article{giannini2012PollinationServicesRisk,
  title = {Pollination Services at Risk: {{Bee}} Habitats Will Decrease Owing to Climate Change in {{Brazil}}},
  shorttitle = {Pollination Services at Risk},
  author = {Giannini, Tereza C. and Acosta, Andr{\'e} L. and Gar{\'o}falo, Carlos A. and Saraiva, Antonio M. and {Alves-dos-Santos}, Isabel and {Imperatriz-Fonseca}, Vera L.},
