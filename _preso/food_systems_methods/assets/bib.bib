  file = {C\:\\Users\\cdonov12\\Zotero\\storage\\4QL329TF\\Bertsimas et al. - 2022 - Solving Large-Scale Sparse PCA to Certifiable (Nea.pdf;C\:\\Users\\cdonov12\\Zotero\\storage\\8LKHPYDW\\ScalableSPCA.html}
}

