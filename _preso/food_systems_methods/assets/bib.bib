  journal = {Forests},
  volume = {2},
  number = {1},
  pages = {301--342},
  issn = {19994907},
  doi = {10.3390/f2010301},
  abstract = {Land tenure and carbon rights constitute critical issues to take into account in achieving emission reductions, ensuring transparent benefit sharing and determining non-permanence (or non-compliance) liabilities in the context of REDD+ strategies and projects. This is so because tenure systems influence who becomes involved in efforts to avoid deforestation and improve forest management, and that land tenure, carbon rights and liabilities may be linked or divorced with implications for rural development. This paper explores these issues by looking at tenure regimes and carbon rights issues in Mexico, Brazil and Costa Rica. It is effectively shown that complex bundles of rights over forest resources have distinct implications for REDD+ design and implementation, and that REDD+ strategies in selected countries have to date failed in procedurally addressing land-use conflicts and carbon rights entitlements and liabilities. {\copyright} 2011 by the authors.},
  keywords = {Carbon,Forests,Latin america,Property rights,REDD+},
  file = {C:\Users\cdonov12\Zotero\storage\E8EIN3F8\forests-02-00301-v2-1.pdf}
