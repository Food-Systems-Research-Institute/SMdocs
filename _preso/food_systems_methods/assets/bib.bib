  author = {Giannini, Tereza C. and {Maia-Silva}, Camila and Acosta, Andre L. and Jaff{\'e}, Rodolfo and Carvalho, Airton T. and Martins, Celso F. and Zanella, Fernando C. V. and Carvalho, Carlos A. L. and Hrncir, Michael and Saraiva, Antonio M. and Siqueira, Jos{\'e} Oswaldo and {Imperatriz-Fonseca}, Vera L.},
