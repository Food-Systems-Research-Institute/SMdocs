@article{porterHarmonizationTranslationCrop2014,
  title = {Harmonization and Translation of Crop Modeling Data to Ensure Interoperability},
  author = {Porter, Cheryl H. and Villalobos, Chris and Holzworth, Dean and Nelson, Roger and White, Jeffrey W. and Athanasiadis, Ioannis N. and Janssen, Sander and Ripoche, Dominique and Cufi, Julien and Raes, Dirk and Zhang, Meng and Knapen, Rob and Sahajpal, Ritvik and Boote, Kenneth and Jones, James W.},
  year = 2014,
  month = dec,
  journal = {Environmental Modelling \& Software},
  volume = {62},
  pages = {495--508},
  issn = {1364-8152},
  doi = {10.1016/j.envsoft.2014.09.004},
  urldate = {2024-06-02},
  abstract = {The Agricultural Model Intercomparison and Improvement Project (AgMIP) seeks to improve the capability of ecophysiological and economic models to describe the potential impacts of climate change on agricultural systems. AgMIP protocols emphasize the use of multiple models; consequently, data harmonization is essential. This interoperability was achieved by establishing a data exchange mechanism with variables defined in accordance with international standards; implementing a flexibly structured data schema to store experimental data; and designing a method to fill gaps in model-required input data. Researchers and modelers are able to use these tools to run an ensemble of~models on a single, harmonized dataset. This allows them to compare models directly, leading ultimately to model improvements. An important outcome is the development of a platform that facilitates researcher collaboration from many organizations, across many countries. This would have been very difficult to achieve without the AgMIP data interoperability standards described in this paper.},
  keywords = {Collaborative software design,Crop model,Data structure,Database,Harmonization,Schema},
  file = {C:\Users\cdonov12\Zotero\storage\G4F3U35B\S1364815214002576.html}
}

