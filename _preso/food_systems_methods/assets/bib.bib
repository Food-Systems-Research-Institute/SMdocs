@article{schuldt2018DoesReducedPsychological,
  title = {Does Reduced Psychological Distance Increase Climate Engagement? {{On}} the Limits of Localizing Climate Change},
  shorttitle = {Does Reduced Psychological Distance Increase Climate Engagement?},
  author = {Schuldt, Jonathon P. and Rickard, Laura N. and Yang, Z. Janet},
