  title = {Climate Change Issue and Theory of Planned Behaviour: Relationship by Empirical Evidence},
  shorttitle = {Climate Change Issue and Theory of Planned Behaviour},
  author = {Masud, Muhammad Mehedi and {Al-Amin}, Abul Quasem and Junsheng, Ha and Ahmed, Ferdous and Yahaya, Siti Rohani and Akhtar, Rulia and Banna, Hasanul},
