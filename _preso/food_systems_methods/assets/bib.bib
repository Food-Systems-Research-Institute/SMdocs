  author = {Currin, Rebecca and Meinke, Robert and Raven, Andrea},
  year = 2007,
  number = {5036364112},
  address = {Salem, OR},
  abstract = {Stephanomeria malheurensis (Figure 1) is an extremely rare member of the Asteraceae family, known historically from only one location in Harney County, Oregon. The species was first seen by Dr. Leslie Gottlieb in July of 1966 (Table 1), while he was visiting the 70- acre Bureau of Land Management (BLM) site now known as the Narrows Area of Critical Environmental Concern (ACEC). The newly discovered species was described as Stephanomeria malheurensis by Dr. Gottlieb in 1978 (Gottlieb 1978a) and listed as endangered by the U.S. Fish and Wildlife Service in 1982 (USFWS 1982). By 1985 no S. malheurensis plants were observed at the site, and the species was considered extinct in the wild. Disappearance of S. malheurensis was correlatedcorrelated with a large increase in cheatgrass (Bromus tectorum), a non-native invasive annual grass which had appeared at the site after the fire (Brauner 1988, Gottlieb 1991).}
}

