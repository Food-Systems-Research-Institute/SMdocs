@article{requier2024FirstLargescaleStudy,
  title = {First Large-Scale Study Reveals Important Losses of Managed Honey Bee and Stingless Bee Colonies in {{Latin America}}},
  author = {Requier, Fabrice and Leyton, Malena Sibaja and Morales, Carolina L. and Garibaldi, Lucas A. and Giacobino, Agostina and Porrini, Martin Pablo and {Rosso-Londo{\~n}o}, Juan Manuel and Velarde, Rodrigo A. and Aignasse, Andrea and {Aldea-S{\'a}nchez}, Patricia and Allasino, Mariana Laura and Arredondo, Daniela and Audisio, Carina and Cagnolo, Natalia Bulacio and Basualdo, Marina and Branchiccela, Bel{\'e}n and Calder{\'o}n, Rafael A. and Castelli, Loreley and Castilhos, Dayson and Escare{\~n}o, Francisca Contreras and {Correa-Ben{\'i}tez}, Adriana and {da Silva}, Fabiana Oliveira and Garnica, Diego Silva and {de Groot}, Grecia and {Delgado-Ca{\~n}edo}, Andres and {Fern{\'a}ndez-Mar{\'i}n}, Herm{\'o}genes and Freitas, Breno M. and {Galindo-Cardona}, Alberto and Garcia, Nancy and Garrido, Paula M. and Giray, Tugrul and Gon{\c c}alves, Lionel Segui and Landi, Lucas and Malus{\'a} Gon{\c c}alves, Daniel and Martinez, Silvia In{\'e}s and Moja, Pablo Joaqu{\'i}n and Molineri, Ana and M{\"u}ller, Pablo Fernando and Nogueira, Enrique and Pacini, Adriana and Palacio, Mar{\'i}a Alejandra and Parra, Guiomar Nates and {Parra-H}, Alejandro and Peres Gramacho, K{\'a}tia and Castro, Eleazar P{\'e}rez and Pires, Carmen S{\'i}lvia Soares and Reynaldi, Francisco J. and Luis, Anais Rodr{\'i}guez and Rossini, Carmen and S{\'a}nchez Armijos, Milton and Santos, Estela and Scannapieco, Alejandra and Spina, Yamand{\'u} Mendoza and Tapia Gonz{\'a}lez, Jos{\'e} Mar{\'i}a and Vargas Fern{\'a}ndez, Andr{\'e}s Marcelo and Viana, Blandina Felipe and Vieli, Lorena and Yadr{\'o} Garc{\'i}a, Carlos Ariel and Ant{\'u}nez, Karina},
  year = 2024,
  month = may,
  journal = {Scientific Reports},
  volume = {14},
  number = {1},
  pages = {10079},
  publisher = {Nature Publishing Group},
  issn = {2045-2322},
  doi = {10.1038/s41598-024-59513-6},
  urldate = {2024-07-01},
  abstract = {Over the last quarter century, increasing honey bee colony losses motivated standardized large-scale surveys of managed honey bees (Apis mellifera), particularly in Europe and the United States. Here we present the first large-scale standardized survey of colony losses of managed honey bees and stingless bees across Latin America. Overall, 1736 beekeepers and 165 meliponiculturists participated in the 2-year survey (2016--2017 and 2017--2018). On average, 30.4\% of honey bee colonies and 39.6\% of stingless bee colonies were lost per year across the region. Summer losses were higher than winter losses in stingless bees (30.9\% and 22.2\%, respectively) but not in honey bees (18.8\% and 20.6\%, respectively). Colony loss increased with operation size during the summer in both honey bees and stingless bees and decreased with operation size during the winter in stingless bees. Furthermore, losses differed significantly between countries and across years for both beekeepers and meliponiculturists. Overall, winter losses of honey bee colonies in Latin America (20.6\%) position this region between Europe (12.5\%) and the United States (40.4\%). These results highlight the magnitude of bee colony losses occurring in the region and suggest difficulties in maintaining overall colony health and economic survival for beekeepers and meliponiculturists.},
  copyright = {2024 The Author(s)},
  langid = {english},
  keywords = {Animal physiology,Ecological epidemiology,Ecology,Entomology,Zoology},
  file = {C:\Users\cdonov12\Zotero\storage\JR5XRLWD\Requier et al. - 2024 - First large-scale study reveals important losses o.pdf}
}

