  author = {Saarikoski, Heli and Mustajoki, Jyri and Barton, David N. and Geneletti, Davide and Langemeyer, Johannes and {Gomez-Baggethun}, Erik and Marttunen, Mika and Antunes, Paula and Keune, Hans and Santos, Rui},
