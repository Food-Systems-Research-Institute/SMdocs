@article{canfield2021FoodSystemsSummit,
  title = {{{UN Food Systems Summit}} 2021: {{Dismantling Democracy}} and {{Resetting Corporate Control}} of {{Food Systems}}},
  shorttitle = {{{UN Food Systems Summit}} 2021},
  author = {Canfield, Matthew and Anderson, Molly D. and McMichael, Philip},
