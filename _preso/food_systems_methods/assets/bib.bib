}

@incollection{martinez-lopez2024DiversityConservationMesoamerican,
  title = {Diversity and {{Conservation}} of {{Mesoamerican Bees}}: {{Relative Effects}} of {{Three Major Threats Within}} the {{Potential Distribution}} of {{Bee Species}}},
  shorttitle = {Diversity and {{Conservation}} of {{Mesoamerican Bees}}},
  booktitle = {Insect {{Decline}} and {{Conservation}} in the {{Neotropics}}},
  author = {{Mart{\'i}nez-L{\'o}pez}, Oscar and Arnold, Noemi and Sagot, Philippe and {M{\'e}rida-Rivas}, Jorge and Aldasoro Maya, Elda Miriam and Vandame, R{\'e}my},
  editor = {{Le{\'o}n-Cort{\'e}s}, Jorge L. and {C{\'o}rdoba-Aguilar}, Alex},
  year = 2024,
  pages = {235--250},
  publisher = {Springer International Publishing},
  address = {Cham},
  doi = {10.1007/978-3-031-49255-6_11},
  urldate = {2024-07-01},
  abstract = {Bees have gained attention in recent years due to their importance as pollinators of crops and wild plants, as well as their global decline. Different causes for the decline in bee populations have been studied separately; however, the interactions among these causes are not well understood. We used a method that jointly analyzes the three principal threats affecting the distribution of bees in Mesoamerica, namely climate change, deforestation, and anthropogenic disturbance, the latter being a proxy of the exposure to pesticides and habitat loss. We analyzed records for 30 bee species across Mesoamerica, divided into three biological groups: stingless bees, bumblebees, and solitary bees. Furthermore, we used available climate and land-use data with a 5-km resolution to calculate current and future potential distributions given climate change, and within projected distributions, deforestation, and anthropogenic disturbance. The distribution of most bee species (73\%) is expected to be affected by the threats included in the study. Of all species, 10\% are likely to be affected by these threats to a moderate degree or not at all. By 2050, 84\%, and 16\% of species are expected to decrease and increase their range given climate change scenarios, respectively. Based on our results, we were able to weigh the relative impact of different threats on species distributions, and therefore inform conservation actions. Finally, we discuss the potential uses of this analysis, as well as caveats when scaling our results. We also address the implications of the intensity of the threats facing each biological group and provide suggestions for bee conservation in the Mesoamerican biodiversity hotspot region.},
  isbn = {978-3-031-49255-6},
  langid = {english}
}

@article{martinez-salinas2022InteractingPestControl,
  title = {Interacting Pest Control and Pollination Services in Coffee Systems},
  author = {{Mart{\'i}nez-Salinas}, Alejandra and {Chain-Guadarrama}, Adina and Aristiz{\'a}bal, Natalia and {Vilchez-Mendoza}, Sergio and Cerda, Rolando and Ricketts, Taylor H.},
  year = 2022,
  month = apr,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {119},
  number = {15},
  pages = {e2119959119},
  publisher = {Proceedings of the National Academy of Sciences},
  doi = {10.1073/pnas.2119959119},
  urldate = {2025-03-29},
  abstract = {Biodiversity-mediated ecosystem services (ES) support human well-being, but their values are typically estimated individually. Although ES are part of complex socioecological systems, we know surprisingly little about how multiple ES interact ecologically and economically. Interactions could be positive (synergy), negative (trade-offs), or absent (additive effects), with strong implications for management and valuation. Here, we evaluate the interactions of two ES, pollination and pest control, via a factorial field experiment in 30 Costa Rican coffee farms. We found synergistic interactions between these two critical ES to crop production. The combined positive effects of birds and bees on fruit set, fruit weight, and fruit weight uniformity were greater than their individual effects. This represents experimental evidence at realistic farm scales of positive interactions among ES in agricultural systems. These synergies suggest that assessments of individual ES may underestimate the benefits biodiversity provides to agriculture and human well-being. Using our experimental results, we demonstrate that bird pest control and bee pollination services translate directly into monetary benefits to coffee farmers. Excluding both birds and bees resulted in an average yield reduction of 24.7\% (equivalent to losing US\$1,066.00/ha). These findings highlight that habitat enhancements to support native biodiversity can have multiple benefits for coffee, a valuable crop that supports rural livelihoods worldwide. Accounting for potential interactions among ES is essential to quantifying their combined ecological and economic value.},
