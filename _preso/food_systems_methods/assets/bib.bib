@article{kent2014HeatWavesHealth,
  title = {Heat Waves and Health Outcomes in {{Alabama}} ({{USA}}): {{The}} Importance of Heat Wave Definition},
  shorttitle = {Heat Waves and Health Outcomes in Alabama (Usa)},
  author = {Kent, Shia T. and McClure, Leslie A. and Zaitchik, Benjamin F. and Smith, Tiffany T. and Gohlke, Julia M.},
  year = 2014,
  month = feb,
  journal = {Environmental Health Perspectives},
  volume = {122},
  number = {2},
  pages = {151--158},
  publisher = {Environmental Health Perspectives},
  doi = {10.1289/ehp.1307262},
  urldate = {2024-02-15},
  abstract = {Background: A deeper understanding of how heat wave definition affects the relationship between heat exposure and health, especially as a function of rurality, will be useful in developing effective heat wave warning systems. Objective: We compared the relationships between different heat wave index (HI) definitions and preterm birth (PTB) and nonaccidental death (NAD) across urban and rural areas. Methods: We used a time-stratified case-crossover design to estimate associations of PTB and NAD with heat wave days (defined using 15 HIs) relative to non--heat wave control days in Alabama, USA (1990--2010). ZIP code--level HIs were derived using data from the North American Land Data Assimilation System. Associations with heat wave days defined using different HIs were compared by bootstrapping. We also examined interactions with rurality. Results: Associations varied depending on the HI used to define heat wave days. Heat waves defined as having at least 2 consecutive days with mean daily temperatures above the 98th percentile were associated with 32.4\% (95\% CI: 3.7, 69.1\%) higher PTB, and heat waves defined as at least 2 consecutive days with mean daily temperatures above the 90th percentile were associated with 3.7\% (95\% CI: 1.1, 6.3\%) higher NAD. Results suggest that significant positive associations were more common when relative---compared with absolute---HIs were used to define exposure. Both positive and negative associations were found in each rurality stratum. However, all stratum-specific significant associations were positive, and NAD associations with heat waves were consistently positive in urban strata but not in middle or rural strata. Conclusions: Based on our findings, we conclude that a relative mean-temperature-only heat wave definition may be the most effective metric for heat wave warning systems in Alabama. Citation: Kent ST, McClure LA, Zaitchik BF, Smith TT, Gohlke JM. 2014. Heat waves and health outcomes in Alabama (USA): the importance of heat wave definition. Environ Health Perspect 122:151--158;{\enspace}https://doi.org/10.1289/ehp.1307262},
  file = {C:\Users\cdonov12\Zotero\storage\D73NVKIC\Kent et al. - 2014 - Heat Waves and Health Outcomes in Alabama (USA) T.pdf}
}

@techreport{kerbyProposalPrecisionRestoration,
  title = {Proposal Precision Restoration - Joint Fire Science},
  author = {Kerby, Jay D.},
  pages = {1--10},
  abstract = {Restoration of degraded arid lands is challenging and costly. Expansion of exotic annual grasses coupled with an accelerating fire cycle are rapidly degrading large swaths of sagebrush and putting numerous species, such as the greater sage-grouse, in peril. Warm and dry zones of the sage-steppe are prone to invasion by non-native annual grasses, which aggressively compete for limited resources and may preclude recruitment of native plant seeds introduced by land managers via broadcast or drill seeding. Even in absence of annual grass competition, high spatial and temporal heterogeneity (e.g., short and long term weather patterns, soils, topography) in sage-steppe presents a complex challenge to land managers because numerous ecological barriers preclude success of native seeding in degraded arid sage-steppe. However, recognition of these enables development of innovative seed technologies and approaches. Coupling specific technologies with spatial and temporal predictions of ecological barriers will lead to more successful native seeding practices that meet conservation objectives. For example, in critical sage-grouse habitat, managers may act to accelerate recruitment and establishment of sagebrush in burned, but otherwise intact habitat to maintain landscape cover of sagebrush above critical thresholds for population viability. Land managers are constrained by high costs associated with individual planting of bare root or container seedlings and consistently low success rates of seeding. Successful conservation of sage-steppe must include a diverse ``toolbox,'' but the current scale of wildfire and restoration needs suggests that even small improvements in seeding outcomes would have a significant effect if implemented at a commensurate scale}
}

@article{kerr2015ClimateChangeImpacts,
