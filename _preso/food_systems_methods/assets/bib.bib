@misc{shrum2024REBLScoreDynamic,
  title = {The {{REBL Score}}: {{A}} Dynamic Measure of pro-Environmental Behavior},
  shorttitle = {The {{REBL Score}}},
  author = {Shrum, Trisha and Donovan, Christopher and Bloch, Sadie and Cripps, Emma and Boyson, Ceclia},
