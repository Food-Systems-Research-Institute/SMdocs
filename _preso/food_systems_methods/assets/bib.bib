}

@article{saarikoskiMultiCriteriaDecisionAnalysis2016,
  title = {Multi-{{Criteria Decision Analysis}} and {{Cost-Benefit Analysis}}: {{Comparing}} Alternative Frameworks for Integrated Valuation of Ecosystem Services},
