@incollection{rosenbaum2023PropensityScore,
  title = {Propensity {{Score}}},
  booktitle = {Handbook of {{Matching}} and {{Weighting Adjustments}} for {{Causal Inference}}},
  author = {Rosenbaum, Paul R.},
  year = 2023,
  publisher = {{Chapman and Hall/CRC}},
  abstract = {In several articles in the 1980s, Donald B. Rubin and the author proposed the propensity score as an aid in adjusting for observed covariates in observational studies of causal effects. An important subquestion of the main question is whether patients are being channeled to the appropriate hospitals, in particular, whether high-risk patients are being channeled to the most capable hospitals, and whether that matters for surgical mortality. Superior hospitals tended to have a larger proportion of nurses with advanced degrees, and a larger proportion of registered nurses. Superior hospitals were more often major teaching hospitals. Some estimators or tests directly use estimated propensity scores and outcomes. Propensity scores are helpful in building matched pairs or strata that balance many observed covariates. The discussion has focused on role of propensity scores in matching, stratification, inverse probability weighting, and conditional permutation inference.},
  isbn = {978-1-003-10267-0}
}

