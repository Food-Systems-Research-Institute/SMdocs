  file = {C\:\\Users\\cdonov12\\Zotero\\storage\\SZ45MYN4\\Lacroix - 2018 - Comparing the relative mitigation potential of ind.pdf;C\:\\Users\\cdonov12\\Zotero\\storage\\XD2DLRU2\\S0959652618313982.html}
}

