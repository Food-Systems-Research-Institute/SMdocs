@article{paul2015MentalHealthAdolescents,
  title = {Mental Health among Adolescents Exposed to a Tornado: {{The}} Influence of Social Support and Its Interactions with Sociodemographic Characteristics and Disaster Exposure},
  shorttitle = {Mental Health among Adolescents Exposed to a Tornado},
  author = {Paul, Lisa A. and Felton, Julia W. and Adams, Zachary W. and Welsh, Kyleen and Miller, Stephanie and Ruggiero, Kenneth J.},
  year = 2015,
  journal = {Journal of Traumatic Stress},
  volume = {28},
  number = {3},
  pages = {232--239},
  issn = {1573-6598},
  doi = {10.1002/jts.22012},
  urldate = {2024-05-27},
  abstract = {Approximately 25\% of youths experience a natural disaster and many experience disaster-related distress, including symptoms of posttraumatic stress disorder (PTSD) and depression. This study contributes to the literature by examining PTSD and depressive symptoms among 2,000 adolescents (50.9\% female, 70.5\% White) assessed after exposure to tornadoes in 2011. The authors hypothesized that greater tornado exposure, female sex, and younger age would be associated with distress, and that social support would interact with these associations. Analyses showed that PTSD symptoms were associated with lower levels of social support ({$\beta$} = -.28, p {$<$} .001), greater tornado exposure ({$\beta$} = .14, p {$<$} .001), lower household income ({$\beta$} = -.06, p = .013, female sex ({$\beta$} = -.10, p {$<$} .001), and older age ({$\beta$} = .07, p = .002), with a 3-way interaction between tornado exposure, sex, and social support ({$\beta$} = -.06, p = .017). For boys, the influence of tornado exposure on PTSD symptoms increased as social support decreased. Regardless of level of tornado exposure, low social support was related to PTSD symptoms for girls; depressive symptom results were similar. These findings were generally consistent with the literature and provide guidance for intervention development focused on strengthening social support at the individual, family, and community levels.},
  copyright = {{\copyright} 2015 International Society for Traumatic Stress Studies},
  langid = {english},
  file = {C\:\\Users\\cdonov12\\Zotero\\storage\\JLRJEYZ9\\Paul et al. - 2015 - Mental Health Among Adolescents Exposed to a Torna.pdf;C\:\\Users\\cdonov12\\Zotero\\storage\\4BTTLMWU\\jts.html}
}

@article{paveglio2015UnderstandingSocialImpact,
  title = {Understanding Social Impact from Wildfires: Advancing Means for Assessment},
