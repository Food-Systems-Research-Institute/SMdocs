}

@article{masud2017ImpactSociodemographicFactors,
  title = {Impact of Socio-Demographic Factors on the Mitigating Actions for Climate Change: A Path Analysis with Mediating Effects of Attitudinal Variables},
  shorttitle = {Impact of Socio-Demographic Factors on the Mitigating Actions for Climate Change},
  author = {Masud, Muhammad Mehedi and Akhatr, Rulia and Nasrin, Shamima and Adamu, Ibrahim Mohammed},
