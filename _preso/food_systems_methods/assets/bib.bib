@article{banos-gonzalez2018SensitivityAnalysisSocioEcological,
  title = {Sensitivity {{Analysis}} in {{Socio-Ecological Models}} as a {{Tool}} in {{Environmental Policy}} for {{Sustainability}}},
  author = {{Banos-Gonzalez}, Isabel and {Mart{\'i}nez-Fern{\'a}ndez}, Julia and {Esteve-Selma}, Miguel-{\'A}ngel and {Esteve-Guirao}, Patricia},
  year = 2018,
