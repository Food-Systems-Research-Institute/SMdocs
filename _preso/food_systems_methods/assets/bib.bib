  title = {Big Data Promises and Obstacles: {{Agricultural}} Data Ownership and Privacy},
  shorttitle = {Big Data Promises and Obstacles},
  author = {Wilgenbusch, James Charles and Pardey, Philip G. and Bergstrom, Aaron},
  year = 2022,
  journal = {Agronomy Journal},
  volume = {114},
