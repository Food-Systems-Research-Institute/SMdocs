@article{farleyRolePricesConserving2008,
  title = {The {{Role}} of {{Prices}} in {{Conserving Critical Natural Capital}}},
  author = {Farley, Joshua},
  year = 2008,
  journal = {Conservation Biology},
  volume = {22},
  number = {6},
  pages = {1399--1408},
  issn = {1523-1739},
  doi = {10.1111/j.1523-1739.2008.01090.x},
  urldate = {2023-04-10},
  abstract = {Abstract: Until recent decades, economic decision makers have largely ignored the nonmarket benefits provided by nature, resulting in unprecedented threats to ecological life-support functions. The economic challenge today is to decide how much ecosystem structure can be converted to economic production and how much must be conserved to provide essential ecosystem services. Many economists and a growing number of life scientists hope to address this challenge by estimating the marginal value of environmental benefits and then using this information to make economic decisions. I assessed this approach first by examining the role and effectiveness of the price mechanism in a well-functioning market economy, second by identifying the issues that prevent markets from pricing many ecological benefits, and third by focusing on problems inherent to valuing services generated by complex and poorly understood ecosystems subject to irreversible change. I then focus on critical natural capital (CNC), which generates benefits that are essential to human welfare and have few if any substitutes. When imminent ecological thresholds threaten CNC, conservation is essential and marginal valuation becomes inappropriate. Once conservation needs have been met, remaining ecosystem structure is potentially available for economic production. Demand for this available supply will determine prices. In other words, conservation needs should be price determining, not price determined. Conservation science must help identify CNC and the quantity and quality of ecosystem structure required to ensure its sustained provision.},
  langid = {english},
  keywords = {capital natural critico,critical natural capital,ecological thresholds,ecosystem services,marginal value,monetary valuation,precios,prices,servicios del ecosistema,umbrales ecologicos,valor marginal,valoracion monetaria},
  file = {C:\Users\cdonov12\Zotero\storage\69VZZMTG\Farley - 2008 - The Role of Prices in Conserving Critical Natural .pdf}
}

