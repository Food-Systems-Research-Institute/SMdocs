@article{harring2017UsingPhantomVariables,
  title = {Using Phantom Variables in Structural Equation Modeling to Assess Model Sensitivity to External Misspecification},
  author = {Harring, Jeffrey R. and McNeish, Daniel M. and Hancock, Gregory R.},
  year = 2017,
  month = dec,
  journal = {Psychological Methods},
  volume = {22},
  number = {4},
  pages = {616--631},
  issn = {1939-1463},
  doi = {10.1037/met0000103},
  abstract = {External misspecification, the omission of key variables from a structural model, can fundamentally alter the inferences one makes without such variables present. This article presents 2 strategies for dealing with omitted variables, the first a fixed parameter approach incorporating the omitted variable into the model as a phantom variable where all associated parameter values are fixed, and the other a random parameter approach specifying prior distributions for all of the phantom variable's associated parameter values under a Bayesian framework. The logic and implementation of these methods are discussed and demonstrated on an applied example from the educational psychology literature. The argument is made that such external misspecification sensitivity analyses should become a routine part of measured and latent variable modeling where the inclusion of all salient variables might be in question. (PsycINFO Database Record},
  langid = {english},
  pmid = {29265846},
  keywords = {Adult,Bayes Theorem,Child,Data Interpretation Statistical,Humans,Models Statistical,Psychology,Psychology Educational,School Teachers,Students}
}

