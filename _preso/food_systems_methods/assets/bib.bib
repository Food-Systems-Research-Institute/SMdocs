@article{assuncao2020RethinkingUrbanSustainability,
  title = {Rethinking Urban Sustainability Using Fuzzy Cognitive Mapping and System Dynamics},
  author = {Assun{\c c}{\~a}o, E. R. G. T. R. and Ferreira, F. A. F. and {Meidut{\.e}-Kavaliauskien{\.e}}, I. and Zopounidis, C. and Pereira, L. F. and Correia, R. J. C.},
  year = 2020,
