@article{brownIntegratingConservationDevelopment2003,
  title = {Integrating Conservation and Development: A Case of Institutional Misfit},
  shorttitle = {Integrating Conservation and Development},
  author = {Brown, Katrina},
  year = 2003,
  journal = {Frontiers in Ecology and the Environment},
  volume = {1},
