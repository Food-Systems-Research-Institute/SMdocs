@article{lopez-flores2023MachineLearningApproach,
  title = {A Machine Learning Approach for Optimizing the Water-Energy-Food-Ecosystem Nexus: A Resilience Perspective for Sustainability},
  shorttitle = {A Machine Learning Approach for Optimizing the Water-Energy-Food-Ecosystem Nexus},
