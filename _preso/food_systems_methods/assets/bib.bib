@article{rickard2016HereNowThere,
  title = {Here and Now, There and Then: {{How}} ``Departure Dates'' Influence Climate Change Engagement},
  shorttitle = {Here and Now, There and Then},
  author = {Rickard, Laura N. and Yang, Z. Janet and Schuldt, Jonathon P.},
