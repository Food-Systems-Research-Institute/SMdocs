  journal = {Psychological Science},
  volume = {24},
  number = {11},
  pages = {2290--2296},
  publisher = {SAGE Publications Inc},
  issn = {0956-7976},
  doi = {10.1177/0956797613492775},
  urldate = {2025-05-10},
  abstract = {A naturalistic investigation of New Jersey residents, both before and after they experienced Hurricanes Irene and Sandy, examined support for politicians committed or opposed to policies designed to combat climate change. At Time 1, before both hurricanes, participants showed negative implicit attitudes toward a green politician, but at Time 2, after the hurricanes, participants drawn from the same cohort showed a reversed automatic preference. Moreover, those who were significantly affected by Hurricane Sandy were especially likely to implicitly prefer the green politician, and implicit attitudes were the best predictor of voting after the storms, whereas explicit climate-change beliefs was the best predictor before the storms. In concert, the results suggest that direct experience with extreme weather can increase pro-environmentalism, and further support conceptualizing affective experiences as a source of implicit attitudes.},
